# === Existing (competitor site crawlers) ===
Tempe_username=your_username_here
Tempe_password=your_password_here

# === SAP auto-login (Phase 1 of daily_pipeline) ===
# User's SAP GUI login credentials.  User + Client + Language + Connection
# live here in plain text (low sensitivity); the PASSWORD is stored in the
# Windows Credential Manager via `keyring` — set it once with:
#     python sap_login.py --set-password
# and it survives Windows reboots.  Never put the SAP password in this file.
SAP_USER=your_sap_userid
SAP_CLIENT=100
SAP_LANGUAGE=EN
# SAP Logon 창에 표시되는 시스템 이름 (예: "PRD", "P01", "Hankook Production")
SAP_CONNECTION=PRD

# === Notification recipients for daily_pipeline (success + failure) ===
# Semicolon-separated.  Same list is used for success and failure emails
# per user's Phase 5 spec (unified notification).
NOTIFY_ON_SAP_FAIL=brian.park@hankooktyre.com.au;pamela@hankooktyre.com.au;russell.ng@hankooktyre.com.au

# === (Optional) SMTP override just for daily_pipeline ===
# By default daily_pipeline reuses the same SMTP_* / GRAPH_* settings that
# app.py uses (see app.py:13460 onward).  Only set these if you want the
# pipeline to send through a different mailbox than the dashboard.
# PIPELINE_MAIL_FROM=
# PIPELINE_SMTP_HOST=
# PIPELINE_SMTP_PORT=587
# PIPELINE_SMTP_USER=
# PIPELINE_SMTP_PASSWORD=
