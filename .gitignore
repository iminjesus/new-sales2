__pycache__/
*.pyc
*.pyo
*.pyd

# Crawl output CSVs (generated by crawling scripts — do not track)
Tempe_*.csv
JAX_*.csv
BobJane_*.csv

# Debug screenshots from crawlers
*.png

# Misc
*.log
.env

# SAP password rotation sidecar (batch_sap_logon.py writes the
# newly-accepted password here after a successful change-password
# dialog so the next batch run picks it up automatically).  Local
# only — must never land in git.
.sap_pwd_current
.sap_pwd_current.tmp

# Pre-computed /price dashboard data cache (built by
# build_price_dashboard_cache.py, or lazily by the first /price
# request after a cache miss).  Invalidated automatically from the
# source CSV mtimes, so there's no reason to commit it.
.price_dashboard_cache.pkl.gz
.price_dashboard_cache.pkl.gz.tmp

# User-uploaded photos from /meeting (kept on disk, not tracked)
static/meeting_photos/

# Large GeoJSON boundary files (downloaded from ABS, ~15-200 MB —
# too big for git; each dev / deploy places their own copy at this
# path).  See /map "Show postcode boundaries" for the loader.
static/postcode_boundaries.geojson
static/*.geojson

# Vehicle registration / rego processing output
out/rego/
/.crawler_progress.json
